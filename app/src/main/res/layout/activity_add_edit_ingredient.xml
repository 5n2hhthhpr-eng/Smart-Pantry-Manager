<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/pantry_background"
        android:scaleType="centerCrop"
        android:alpha="0.66"
        android:contentDescription="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtIngredientTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredient Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/olive_dark"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtIngredientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Tomatoes"
            android:inputType="text"
            android:backgroundTint="@color/olive_primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/olive_dark"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/edtIngredientQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 2"
            android:inputType="numberDecimal"
            android:backgroundTint="@color/olive_primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unit"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/olive_dark"
            android:layout_marginBottom="18dp"/>

        <EditText
            android:id="@+id/edtIngredientUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. kg, cups, items"
            android:backgroundTint="@color/olive_primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry Date (Optional)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/olive_dark"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/edtIngredientExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tap to select a date"
            android:inputType="text"
            android:focusable="false"
            android:backgroundTint="@color/olive_primary"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Ingredient"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

    </LinearLayout>
    </ScrollView>
</FrameLayout>

